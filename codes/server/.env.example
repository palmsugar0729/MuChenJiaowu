# 复制为 .env 后按需修改。.env 不纳入版本管理。

# ⚠️ 上线前必须换掉。生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-please-change-me

# 数据库位置，默认 codes/server/data/app.db
# DATABASE_URL=sqlite:///./data/app.db

# 想看每条 SQL 就设 true（调试用，生产别开）
SQL_ECHO=false

# H5 前端开发时的跨域来源
# CORS_ORIGINS=["http://localhost:5173"]
